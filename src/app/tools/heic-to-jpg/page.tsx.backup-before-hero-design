"use client";

import { useCallback, useEffect, useRef, useState } from "react";
import JSZip from "jszip";
import {
  Image as ImageIcon,
  Upload,
  Download,
  FileImage,
  CheckCircle2,
  AlertCircle,
  Loader2,
  Trash2,
  X,
  Archive,
  ShieldCheck,
  Zap,
  Settings2,
  ArrowDown,
  RefreshCw,
  Files,
  HardDrive,
  Sparkles,
} from "lucide-react";

type FileStatus = "waiting" | "processing" | "done" | "error";

interface ConversionItem {
  id: string;
  file: File;
  status: FileStatus;
  output?: Blob;
  outputUrl?: string;
  error?: string;
}

const MAX_FILE_SIZE = 40 * 1024 * 1024;

function formatBytes(bytes: number): string {
  if (!bytes) return "0 KB";
  const units = ["Bytes", "KB", "MB", "GB"];
  const index = Math.min(
    Math.floor(Math.log(bytes) / Math.log(1024)),
    units.length - 1
  );
  return `${(bytes / Math.pow(1024, index)).toFixed(index === 0 ? 0 : 2)} ${units[index]}`;
}

function getOutputName(name: string): string {
  return name.replace(/\.(heic|heif)$/i, "") + ".jpg";
}

export default function HeicToJpgPage() {
  const [items, setItems] = useState<ConversionItem[]>([]);
  const [quality, setQuality] = useState(92);
  const [isConverting, setIsConverting] = useState(false);
  const [isZipping, setIsZipping] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [message, setMessage] = useState("");
  const inputRef = useRef<HTMLInputElement>(null);
  const outputUrlsRef = useRef<string[]>([]);
  const stopRef = useRef(false);

  useEffect(() => {
    return () => {
      outputUrlsRef.current.forEach((url) => URL.revokeObjectURL(url));
    };
  }, []);

  const addFiles = useCallback((fileList: FileList | File[]) => {
    const selected = Array.from(fileList);
    const accepted: ConversionItem[] = [];
    const rejected: string[] = [];

    for (const file of selected) {
      const extension = file.name.split(".").pop()?.toLowerCase();
      const isHeic = extension === "heic" || extension === "heif";

      if (!isHeic) {
        rejected.push(`${file.name}: الملف ليس HEIC أو HEIF`);
        continue;
      }

      if (file.size > MAX_FILE_SIZE) {
        rejected.push(`${file.name}: حجم الملف أكبر من 40 ميجابايت`);
        continue;
      }

      accepted.push({
        id: `${Date.now()}-${Math.random().toString(36).slice(2)}`,
        file,
        status: "waiting",
      });
    }

    if (accepted.length) {
      setItems((previous) => [...previous, ...accepted]);
      setMessage("");
    }

    if (rejected.length) {
      setMessage(rejected.slice(0, 3).join(" — "));
    }
  }, []);

  const removeItem = (id: string) => {
    setItems((previous) => {
      const target = previous.find((item) => item.id === id);

      if (target?.outputUrl) {
        URL.revokeObjectURL(target.outputUrl);
      }

      return previous.filter((item) => item.id !== id);
    });
  };

  const clearAll = () => {
    if (isConverting) return;

    items.forEach((item) => {
      if (item.outputUrl) URL.revokeObjectURL(item.outputUrl);
    });

    setItems([]);
    setMessage("");

    if (inputRef.current) inputRef.current.value = "";
  };

  const convertAll = async () => {
    const pending = items.filter(
      (item) => item.status === "waiting" || item.status === "error"
    );

    if (!pending.length || isConverting) return;

    setIsConverting(true);
    setMessage("");
    stopRef.current = false;

    try {
      const module = await import("heic2any");
      const heic2any = module.default;

      for (const item of pending) {
        if (stopRef.current) break;

        setItems((previous) =>
          previous.map((entry) =>
            entry.id === item.id
              ? { ...entry, status: "processing", error: undefined }
              : entry
          )
        );

        try {
          const result = await heic2any({
            blob: item.file,
            toType: "image/jpeg",
            quality: quality / 100,
          });

          const outputBlob = Array.isArray(result) ? result[0] : result;

          if (!(outputBlob instanceof Blob) || outputBlob.size === 0) {
            throw new Error("لم يتم إنشاء صورة JPG صالحة.");
          }

          const outputUrl = URL.createObjectURL(outputBlob);
          outputUrlsRef.current.push(outputUrl);

          setItems((previous) =>
            previous.map((entry) =>
              entry.id === item.id
                ? {
                    ...entry,
                    status: "done",
                    output: outputBlob,
                    outputUrl,
                    error: undefined,
                  }
                : entry
            )
          );
        } catch (error) {
          const errorMessage =
            error instanceof Error
              ? error.message
              : "تعذر تحويل هذا الملف.";

          setItems((previous) =>
            previous.map((entry) =>
              entry.id === item.id
                ? {
                    ...entry,
                    status: "error",
                    error: errorMessage,
                  }
                : entry
            )
          );
        }
      }
    } catch {
      setMessage(
        "تعذر تحميل مكتبة التحويل. تحقق من اتصال الإنترنت ثم أعد المحاولة."
      );
    } finally {
      setIsConverting(false);
    }
  };

  const downloadOne = (item: ConversionItem) => {
    if (!item.output) return;

    const url = item.outputUrl || URL.createObjectURL(item.output);
    const link = document.createElement("a");

    link.href = url;
    link.download = getOutputName(item.file.name);
    document.body.appendChild(link);
    link.click();
    link.remove();
  };

  const downloadZip = async () => {
    const completed = items.filter(
      (item) => item.status === "done" && item.output
    );

    if (!completed.length || isZipping) return;

    setIsZipping(true);

    try {
      const zip = new JSZip();

      completed.forEach((item) => {
        zip.file(getOutputName(item.file.name), item.output as Blob);
      });

      const zipBlob = await zip.generateAsync({ type: "blob" });
      const url = URL.createObjectURL(zipBlob);
      const link = document.createElement("a");

      link.href = url;
      link.download = "intooly-heic-to-jpg.zip";
      document.body.appendChild(link);
      link.click();
      link.remove();

      setTimeout(() => URL.revokeObjectURL(url), 1500);
    } catch {
      setMessage("حدث خطأ أثناء إنشاء ملف ZIP. حاول مرة أخرى.");
    } finally {
      setIsZipping(false);
    }
  };

  const completedCount = items.filter((item) => item.status === "done").length;
  const errorCount = items.filter((item) => item.status === "error").length;
  const totalOriginal = items.reduce((sum, item) => sum + item.file.size, 0);
  const totalOutput = items.reduce(
    (sum, item) => sum + (item.output?.size || 0),
    0
  );

  return (
    <main dir="rtl" className="min-h-screen bg-slate-50 text-slate-900">
      <div className="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">

        {/* Hero */}
        <section className="mb-8 text-center">
          <div className="mb-4 inline-flex items-center gap-2 rounded-full border border-orange-200 bg-orange-50 px-4 py-2 text-sm font-semibold text-orange-700">
            <Sparkles size={16} />
            أداة مجانية من Intooly
          </div>

          <h1 className="mb-4 text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            تحويل HEIC إلى JPG مجانًا أونلاين
          </h1>

          <p className="mx-auto max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">
            حوّل صور iPhone بصيغة HEIC وHEIF إلى JPG بسهولة. أضف صورة واحدة
            أو مجموعة صور، واختر جودة التحويل، ثم نزّل الصور مباشرة إلى جهازك.
          </p>

          <div className="mt-5 flex flex-wrap items-center justify-center gap-4 text-sm text-slate-600">
            <span className="inline-flex items-center gap-1.5">
              <ShieldCheck size={17} className="text-green-600" />
              معالجة داخل المتصفح
            </span>
            <span className="inline-flex items-center gap-1.5">
              <Zap size={17} className="text-orange-500" />
              بدون تثبيت برامج
            </span>
            <span className="inline-flex items-center gap-1.5">
              <Files size={17} className="text-blue-600" />
              تحويل عدة صور
            </span>
          </div>
        </section>

        {/* Main Tool */}
        <section className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60">

          <div className="border-b border-slate-100 bg-gradient-to-l from-orange-50 via-white to-amber-50 px-5 py-5 sm:px-8">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-3">
                <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-100 text-orange-600">
                  <FileImage size={25} />
                </div>
                <div>
                  <h2 className="text-xl font-bold text-slate-900">
                    محول صور HEIC إلى JPG
                  </h2>
                  <p className="mt-1 text-sm text-slate-500">
                    أضف الصور وابدأ التحويل في خطوات بسيطة
                  </p>
                </div>
              </div>

              <span className="rounded-full border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700">
                مجاني
              </span>
            </div>
          </div>

          <div className="p-5 sm:p-8">

            {/* Upload */}
            <div
              onDragOver={(event) => {
                event.preventDefault();
                setIsDragging(true);
              }}
              onDragLeave={(event) => {
                event.preventDefault();
                setIsDragging(false);
              }}
              onDrop={(event) => {
                event.preventDefault();
                setIsDragging(false);
                addFiles(event.dataTransfer.files);
              }}
              onClick={() => inputRef.current?.click()}
              className={`group cursor-pointer rounded-2xl border-2 border-dashed px-5 py-10 text-center transition-all sm:py-14 ${
                isDragging
                  ? "border-orange-500 bg-orange-50"
                  : "border-slate-300 bg-slate-50 hover:border-orange-400 hover:bg-orange-50/50"
              }`}
            >
              <input
                ref={inputRef}
                type="file"
                accept=".heic,.heif,image/heic,image/heif"
                multiple
                className="hidden"
                onChange={(event) => {
                  if (event.target.files) addFiles(event.target.files);
                  event.target.value = "";
                }}
              />

              <div className="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-orange-100 text-orange-600 transition-transform group-hover:scale-105">
                <Upload size={30} />
              </div>

              <h3 className="mb-2 text-lg font-bold text-slate-800">
                اسحب صور HEIC وأفلتها هنا
              </h3>

              <p className="mb-5 text-sm text-slate-500">
                أو اضغط لاختيار الصور من جهازك
              </p>

              <span className="inline-flex items-center gap-2 rounded-xl bg-orange-600 px-6 py-3 font-semibold text-white shadow-lg shadow-orange-600/20 transition hover:bg-orange-700">
                <ImageIcon size={18} />
                اختيار الصور
              </span>

              <p className="mt-5 text-xs text-slate-400">
                يدعم HEIC وHEIF — الحد الأقصى للملف الواحد 40 ميجابايت
              </p>
            </div>

            {/* Quality */}
            <div className="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
              <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
                <div className="flex items-center gap-2 font-bold text-slate-800">
                  <Settings2 size={19} className="text-orange-600" />
                  إعدادات جودة JPG
                </div>

                <span className="rounded-lg bg-orange-50 px-3 py-1.5 text-sm font-bold text-orange-700">
                  {quality}%
                </span>
              </div>

              <input
                type="range"
                min="70"
                max="100"
                step="1"
                value={quality}
                disabled={isConverting}
                onChange={(event) => setQuality(Number(event.target.value))}
                className="h-2 w-full cursor-pointer accent-orange-600 disabled:cursor-not-allowed"
              />

              <div className="mt-2 flex justify-between text-xs text-slate-400">
                <span>70% — حجم أصغر</span>
                <span>85% — متوازن</span>
                <span>100% — جودة أعلى</span>
              </div>

              <p className="mt-3 text-xs leading-6 text-slate-500">
                رفع الجودة قد يزيد حجم الملف. صيغة JPG تستخدم ضغطًا مع فقدان
                بعض البيانات، لذلك لا تعني جودة 100% تحويلًا بلا فقدان.
              </p>
            </div>

            {/* Messages */}
            {message && (
              <div className="mt-5 flex items-start gap-2 rounded-xl border border-red-200 bg-red-50 p-4 text-sm leading-6 text-red-700">
                <AlertCircle size={19} className="mt-0.5 shrink-0" />
                <span>{message}</span>
              </div>
            )}

            {/* Files */}
            {items.length > 0 && (
              <div className="mt-8">
                <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <h3 className="text-lg font-bold text-slate-900">
                      الصور المضافة
                    </h3>
                    <p className="mt-1 text-sm text-slate-500">
                      {items.length} ملف — {completedCount} تم تحويله
                      {errorCount > 0 ? ` — ${errorCount} تعذر تحويله` : ""}
                    </p>
                  </div>

                  <button
                    type="button"
                    onClick={clearAll}
                    disabled={isConverting}
                    className="inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-red-600 transition hover:bg-red-50 disabled:opacity-40"
                  >
                    <Trash2 size={16} />
                    مسح الكل
                  </button>
                </div>

                <div className="space-y-3">
                  {items.map((item) => (
                    <div
                      key={item.id}
                      className="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-4 sm:flex-row sm:items-center"
                    >
                      <div className="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-orange-50 text-orange-600">
                        {item.outputUrl ? (
                          <img
                            src={item.outputUrl}
                            alt=""
                            className="h-full w-full rounded-xl object-cover"
                          />
                        ) : (
                          <FileImage size={27} />
                        )}
                      </div>

                      <div className="min-w-0 flex-1">
                        <p className="truncate text-sm font-bold text-slate-800">
                          {item.file.name}
                        </p>

                        <div className="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-slate-500">
                          <span>{formatBytes(item.file.size)}</span>
                          <span>HEIC / HEIF</span>
                          {item.output && (
                            <>
                              <span>JPG: {formatBytes(item.output.size)}</span>
                              <span className="text-green-700">
                                {item.output.size < item.file.size
                                  ? `توفير ${Math.round((1 - item.output.size / item.file.size) * 100)}%`
                                  : "تم التحويل"}
                              </span>
                            </>
                          )}
                        </div>

                        {item.status === "error" && (
                          <p className="mt-2 text-xs text-red-600">
                            {item.error}
                          </p>
                        )}

                        {item.status === "processing" && (
                          <p className="mt-2 text-xs font-semibold text-orange-600">
                            جارٍ تحويل الصورة...
                          </p>
                        )}
                      </div>

                      <div className="flex items-center justify-between gap-3 sm:justify-end">
                        <div className="text-sm">
                          {item.status === "waiting" && (
                            <span className="text-slate-400">في الانتظار</span>
                          )}
                          {item.status === "processing" && (
                            <span className="inline-flex items-center gap-1.5 text-orange-600">
                              <Loader2 size={16} className="animate-spin" />
                              تحويل
                            </span>
                          )}
                          {item.status === "done" && (
                            <span className="inline-flex items-center gap-1.5 font-semibold text-green-600">
                              <CheckCircle2 size={17} />
                              مكتمل
                            </span>
                          )}
                          {item.status === "error" && (
                            <span className="inline-flex items-center gap-1.5 text-red-600">
                              <AlertCircle size={17} />
                              خطأ
                            </span>
                          )}
                        </div>

                        {item.status === "done" && (
                          <button
                            type="button"
                            onClick={() => downloadOne(item)}
                            className="flex h-10 w-10 items-center justify-center rounded-xl bg-orange-50 text-orange-700 transition hover:bg-orange-100"
                            title="تنزيل JPG"
                            aria-label="تنزيل صورة JPG"
                          >
                            <Download size={19} />
                          </button>
                        )}

                        {!isConverting && (
                          <button
                            type="button"
                            onClick={() => removeItem(item.id)}
                            className="flex h-10 w-10 items-center justify-center rounded-xl text-slate-400 transition hover:bg-red-50 hover:text-red-600"
                            title="حذف الملف"
                            aria-label="حذف الملف"
                          >
                            <X size={19} />
                          </button>
                        )}
                      </div>
                    </div>
                  ))}
                </div>

                {/* Actions */}
                <div className="mt-6 flex flex-col gap-3 sm:flex-row">
                  <button
                    type="button"
                    onClick={convertAll}
                    disabled={
                      isConverting ||
                      !items.some(
                        (item) =>
                          item.status === "waiting" || item.status === "error"
                      )
                    }
                    className="flex flex-1 items-center justify-center gap-2 rounded-xl bg-orange-600 px-5 py-4 font-bold text-white shadow-lg shadow-orange-600/20 transition hover:bg-orange-700 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    {isConverting ? (
                      <>
                        <Loader2 size={19} className="animate-spin" />
                        جارٍ تحويل الصور...
                      </>
                    ) : (
                      <>
                        <RefreshCw size={19} />
                        تحويل الصور إلى JPG
                      </>
                    )}
                  </button>

                  <button
                    type="button"
                    onClick={downloadZip}
                    disabled={completedCount === 0 || isZipping}
                    className="flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-4 font-bold text-slate-700 transition hover:border-orange-300 hover:bg-orange-50 disabled:cursor-not-allowed disabled:opacity-50"
                  >
                    {isZipping ? (
                      <Loader2 size={19} className="animate-spin" />
                    ) : (
                      <Archive size={19} />
                    )}
                    تنزيل الكل ZIP
                  </button>
                </div>

                {completedCount > 0 && (
                  <div className="mt-5 rounded-2xl border border-green-200 bg-green-50 p-4">
                    <div className="flex items-center gap-2 font-bold text-green-800">
                      <CheckCircle2 size={19} />
                      اكتمل تحويل {completedCount} صورة
                    </div>
                    <p className="mt-2 text-sm leading-6 text-green-800">
                      الحجم الأصلي للصور المكتملة:{" "}
                      {formatBytes(
                        items
                          .filter((item) => item.status === "done")
                          .reduce((sum, item) => sum + item.file.size, 0)
                      )}
                      {" — "}
                      حجم JPG الناتج:{" "}
                      {formatBytes(
                        items
                          .filter((item) => item.status === "done")
                          .reduce(
                            (sum, item) => sum + (item.output?.size || 0),
                            0
                          )
                      )}
                    </p>
                  </div>
                )}
              </div>
            )}

            {items.length === 0 && (
              <div className="mt-6 flex flex-wrap items-center justify-center gap-2 text-xs text-slate-400">
                <HardDrive size={15} />
                <span>لا يتم رفع الصور إلى خادم الموقع أثناء التحويل</span>
              </div>
            )}
          </div>
        </section>

        {/* How to use */}
        <section className="mt-14">
          <div className="mb-7 text-center">
            <h2 className="text-2xl font-extrabold text-slate-900">
              كيفية تحويل HEIC إلى JPG؟
            </h2>
            <p className="mt-2 text-slate-600">
              حوّل صور iPhone في ثلاث خطوات بسيطة
            </p>
          </div>

          <div className="grid gap-5 md:grid-cols-3">
            {[
              {
                number: "01",
                title: "أضف صور HEIC",
                description:
                  "اسحب الصور إلى منطقة الرفع أو اختر ملفات HEIC وHEIF من جهازك.",
                icon: Upload,
              },
              {
                number: "02",
                title: "اختر جودة JPG",
                description:
                  "حدد مستوى الجودة المناسب، ثم اضغط على زر تحويل الصور.",
                icon: Settings2,
              },
              {
                number: "03",
                title: "نزّل الصور",
                description:
                  "نزّل كل صورة منفردة أو اجمع الصور المكتملة في ملف ZIP واحد.",
                icon: Download,
              },
            ].map((step) => {
              const Icon = step.icon;
              return (
                <div
                  key={step.number}
                  className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg"
                >
                  <div className="mb-4 flex items-center justify-between">
                    <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-orange-50 text-orange-600">
                      <Icon size={23} />
                    </div>
                    <span className="text-2xl font-black text-orange-100">
                      {step.number}
                    </span>
                  </div>
                  <h3 className="mb-2 font-bold text-slate-900">
                    {step.title}
                  </h3>
                  <p className="text-sm leading-7 text-slate-600">
                    {step.description}
                  </p>
                </div>
              );
            })}
          </div>
        </section>

        {/* Information */}
        <section className="mt-14">
          <h2 className="mb-5 text-2xl font-extrabold text-slate-900">
            ما هو تنسيق HEIC ولماذا نحوله إلى JPG؟
          </h2>

          <div className="space-y-4 text-base leading-8 text-slate-700">
            <p>
              HEIC هو تنسيق صور حديث تستخدمه أجهزة iPhone وأجهزة Apple
              الأخرى لحفظ الصور بكفاءة مع حجم ملف أقل مقارنة ببعض التنسيقات
              التقليدية. وقد تواجه مشكلة عند مشاركة هذه الصور أو فتحها على
              أجهزة وبرامج لا تدعم HEIC بشكل مباشر.
            </p>

            <p>
