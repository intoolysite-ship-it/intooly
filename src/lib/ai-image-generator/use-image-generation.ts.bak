'use client';

// Hook مخصص لتوليد الصور بالذكاء الاصطناعي داخل المتصفح

import { useCallback, useRef, useState } from 'react';
import { MODEL_ID, DEFAULT_GUIDANCE_SCALE } from './constants';
import type {
  EngineModule,
  PipelineFn,
  PipelineOptions,
  ProgressCallback,
} from './types';

type GenerateParams = {
  prompt: string;
  negativePrompt: string;
  steps: number;
  width: number;
  height: number;
  seed?: string;
};

export function useImageGeneration() {
  const pipelineRef = useRef<PipelineFn | null>(null);
  const [isLoading, setIsLoading] = useState(false);
  const [status, setStatus] = useState('');
  const [error, setError] = useState('');
  const [engineReady, setEngineReady] = useState(false);

  const loadPipeline = useCallback(async (): Promise<PipelineFn> => {
    if (pipelineRef.current) return pipelineRef.current;

    setStatus('جارٍ تحميل محرك التوليد والنموذج لأول مرة… قد يستغرق دقائق.');

    const { AutoPipelineForImageGeneration } = (await import(
      '@huggingface/transformers'
    )) as unknown as EngineModule;

    const onProgress: ProgressCallback = (progress) => {
      if (progress.progress !== undefined) {
        setStatus(
          `تحميل النموذج: ${Math.round(progress.progress * 100)}%`
        );
      }
    };

    const pipeline = await AutoPipelineForImageGeneration.from_pretrained(
      MODEL_ID,
      {
        device: 'webgpu',
        dtype: 'fp16',
        progress_callback: onProgress,
      }
    );

    pipelineRef.current = pipeline;
    setEngineReady(true);
    setStatus('');
    return pipeline;
  }, []);

  const generate = useCallback(
    async (params: GenerateParams): Promise<string> => {
      const { prompt, negativePrompt, steps, width, height, seed } = params;

      setError('');
      setIsLoading(true);

      try {
        if (!('gpu' in navigator)) {
          throw new Error(
            'متصفحك لا يدعم WebGPU. جرّب أحدث Chrome أو Edge على جهاز يدعم GPU.'
          );
        }

        const pipeline = await loadPipeline();
        setStatus('يجري توليد الصورة محليًا على جهازك…');

        const options: PipelineOptions = {
          negative_prompt: negativePrompt,
          num_inference_steps: steps,
          guidance_scale: DEFAULT_GUIDANCE_SCALE,
          width,
          height,
        };

        if (seed && seed.trim()) {
          options.seed = Number(seed) || 0;
        }

        const output = await pipeline(prompt, options);
        const rawImage = output.images[0];

        if (!rawImage?.toCanvas) {
          throw new Error('صيغة خرج النموذج غير متوقعة.');
        }

        const canvas = rawImage.toCanvas();
        return canvas.toDataURL('image/png');
      } catch (e) {
        const message =
          e instanceof Error
            ? e.message
            : 'فشل التوليد. تحقق من WebGPU والذاكرة المتاحة.';
        setError(message);
        throw e;
      } finally {
        setIsLoading(false);
        setStatus('');
      }
    },
    [loadPipeline]
  );

  return {
    generate,
    isLoading,
    status,
    error,
    setError,
    engineReady,
  };
}
