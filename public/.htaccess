# إعادة كتابة الروابط لتعمل صفحات Next.js الثابتة على Apache
RewriteEngine On

# إذا كان الملف أو المجلد موجوداً بالفعل، لا تفعل شيئاً
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# إذا لم يكن هناك امتداد .html، حاول إضافة .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule !.*\.html$ %{REQUEST_FILENAME}.html [L]

# إذا كان الرابط ينتهي بشرطة مائلة، ابحث عن index.html داخل المجلد
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1/index.html [L]